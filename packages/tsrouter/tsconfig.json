{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": [
                "./*"
            ],
        }
    },
    "include": [
        "src-client",
        "src-server",
        "types",
        "utils",
    ]
}