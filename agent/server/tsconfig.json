{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@prisma/*": [
                "./prisma/*"
            ],
        }
    },
    "include": [
        "src",
    ]
}